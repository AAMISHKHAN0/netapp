# Database (Supabase Managed Postgres)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Redis (Upstash Managed Redis)
UPSTASH_REDIS_URL="rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6379"

# Auth & Multi-Tenancy
NEXTAUTH_SECRET="smartisp_super_secret_jwt_key_32_chars_min"
NEXTAUTH_URL="http://localhost:3000"
DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="smartisp_evolution_secret_key"
EVOLUTION_INSTANCE_NAME="smartisp_main"
