{
  "name": "smartisp-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter @smartisp/web dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @smartisp/database db:generate",
    "db:push": "pnpm --filter @smartisp/database db:push",
    "db:seed": "pnpm --filter @smartisp/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "turbo": "^2.4.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4"
}
